TATUM_API_KEY=your_tatum_api_key_here

# Comma-separated Origin/Host allowlist for /api/* proxies (required in production)
API_ALLOWED_HOSTS=apps.tatum.io,robinhood-trader-info.webflow.io,localhost,127.0.0.1

# Optional mount path when deployed under apps.tatum.io
# NEXT_PUBLIC_BASE_PATH=/robinhood-trader-info

# Best-effort per-IP + per-route rate limits (defaults shown)
# API_RATE_LIMIT=60
# API_RATE_WINDOW_MS=60000
